<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Billing Engine Admin</label>
    <description
  >Full access to billing engine objects, all records, and the Billing Setting custom metadata type (rate configuration).</description>
    <hasActivationRequired>false</hasActivationRequired>

    <objectPermissions>
        <object>Engagement__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Time_Entry__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Invoice__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Milestone__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Project_Update__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions><field>Engagement__c.Account__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Engagement__c.Budget_Amount__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Engagement__c.Start_Date__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>

    <fieldPermissions><field>Time_Entry__c.Billed__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Time_Entry__c.Consultant__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Time_Entry__c.Description__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>

    <fieldPermissions><field>Invoice__c.Period_End__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Invoice__c.Period_Start__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>

    <fieldPermissions><field>Milestone__c.Due_Date__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>

    <fieldPermissions><field>Project_Update__c.Summary__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field
    >Project_Update__c.Visible_to_Client__c</field><readable
    >true</readable><editable>true</editable></fieldPermissions>

    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Billing_Setting__mdt</name>
    </customMetadataTypeAccesses>

    <tabSettings>
        <tab>Engagement__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Time_Entry__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Invoice__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Milestone__c</tab>
